{
  "name": "muselio-web",
  "version": "1.0.0",
  "description": "Galerie d'Art Domaine Public avec mise à jour automatique",
  "main": "index.html",
  "scripts": {
    "fetch-artworks": "node scripts/fetch-artworks.js",
    "validate": "node scripts/validate-artworks.js",
    "stats": "node scripts/log-stats.js",
    "update": "npm run fetch-artworks && npm run validate && npm run stats",
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "keywords": [
    "art",
    "gallery",
    "public-domain",
    "museum",
    "api"
  ],
  "author": "Lounes Bouzoua",
  "license": "MIT",
  "dependencies": {
    "node-fetch": "^2.7.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "nodemailer": "^6.9.7",
    "stripe": "^13.8.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
